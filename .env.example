# .env.local (Example)
# Copy this file to .env.local and configure with actual values

# Google Gemini API Key - Required for AI narrative generation (server-side only)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Enable token-budget-based prompt truncation
# Default is off; set to "true" to enable.
ENABLE_TOKEN_BUDGET_MANAGER=false

# Feature flags for migration safety (default off)
NEXT_PUBLIC_FEATURE_BUFFERED_STREAMING=false
NEXT_PUBLIC_FEATURE_PROGRESSIVE_DISCLOSURE=false
NEXT_PUBLIC_FEATURE_VIRTUALIZATION=false