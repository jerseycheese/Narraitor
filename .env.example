# .env.local (Example)
# Copy this file to .env.local and configure with actual values

# Google Gemini API Key - Required for AI narrative generation (server-side only)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Enable token-budget-based prompt truncation
# Default is off; set to "true" to enable.
ENABLE_TOKEN_BUDGET_MANAGER=false

# Optional: AI Generation Tuning
# Maximum number of recent decisions to include in prompt context (Default: 10)
# NARRATIVE_DECISION_CONTEXT_LIMIT=10
# Threshold for Jaccard similarity filtering of choices (Default: 0.7)
# CHOICE_SIMILARITY_THRESHOLD=0.7
# Number of choices to generate per request for filtering pool (Default: 5)
# CHOICE_GENERATION_COUNT=5
