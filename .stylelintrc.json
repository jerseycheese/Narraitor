{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [true, {
      "ignoreAtRules": ["tailwind", "apply", "variants", "responsive", "screen", "layer"]
    }],
    "color-no-hex": true,
    "color-named": "never", 
    "function-disallowed-list": [
      "rgb",
      "rgba"
    ],
    "declaration-property-value-disallowed-list": {
      "/^(background|border|color|fill|stroke|outline|text-decoration|box-shadow).*$/": [
        "/^#[0-9a-fA-F]+$/",
        "/^rgb\\(/",
        "/^rgba\\(/",
        "/^(red|blue|green|yellow|orange|purple|pink|brown|indigo|violet|cyan|teal|lime|emerald|sky|rose|slate|stone|neutral|zinc|fuchsia|magenta)$/i"
      ]
    },
    "function-allowed-list": ["hsl", "hsla", "var", "calc", "theme", "translateY", "translateX", "translate", "scale", "rotate"],
    "declaration-property-value-no-unknown": [true, {
      "ignoreProperties": {
        "/color/": ["/^theme\\(/", "/^hsl\\(var\\(/"],
        "/background/": ["/^theme\\(/", "/^hsl\\(var\\(/"],
        "/border/": ["/^theme\\(/", "/^hsl\\(var\\(/", "/.*theme\\(/"],
        "/padding/": ["/^theme\\(/"],
        "/margin/": ["/^theme\\(/"],
        "/border-radius/": ["/^theme\\(/"],
        "/box-shadow/": ["/^theme\\(/"]
      }
    }],
    "custom-property-pattern": null,
    "property-no-vendor-prefix": null,
    "rule-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "no-descending-specificity": null,
    "declaration-empty-line-before": null
  },
    "ignoreFiles": [
      "node_modules/**/*",
      "dist/**/*",
      "build/**/*",
      ".next/**/*",
      "storybook-static/**/*",
      ".storybook/**/*",
      "playwright-html-report/**/*",
      "**/trace/**/*",
      "coverage/**/*",
      "**/*.test.css",
      "**/*.spec.css",
      "public_docs/**/*"
    ],
    "overrides": [
      {
        "files": ["src/app/globals.css"],
        "rules": {
          "function-allowed-list": ["hsl", "hsla", "var", "calc", "theme", "translateY", "translateX", "translate", "scale", "rotate", "linear-gradient", "min", "max", "clamp", "minmax", "rgb", "rgba", "blur"],
          "function-disallowed-list": [],
          "declaration-property-value-disallowed-list": {
            "/^(background|border|color|fill|stroke|outline|text-decoration|box-shadow).*$/": [
              "/^#[0-9a-fA-F]+$/",
              "/^(red|blue|green|yellow|orange|purple|pink|brown|indigo|violet|cyan|teal|lime|emerald|sky|rose|slate|stone|neutral|zinc|fuchsia|magenta)$/i"
            ]
          }
        }
      }
    ]
  }
  