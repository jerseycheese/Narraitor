{
  "name": "narraitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/kill-port.sh 3000 && next dev -p 3000",
    "dev:turbo": "next dev --turbopack",
    "kill": "pkill -f 'next dev' || true",
    "build": "next build && rm -rf public/storybook-static && npm run build-storybook && cp -r storybook-static public/",
    "build:app": "next build",
    "start": "next start",
    "lint": "next lint",
    "style:no-tailwind": "bash scripts/design-system/tailwind-clean-slate/assert-no-tailwind-usage.sh",
    "lint:layout-usage": "node scripts/verify-page-layout-usage.cjs",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "npm run build-storybook && gh-pages -d storybook-static",
    "test": "jest --config=jest.config.cjs",
    "test:prompt-templates": "jest --config=jest.config.cjs src/lib/promptTemplates/promptTemplateManager.test.ts",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:ci": "node --max-old-space-size=4096 node_modules/.bin/jest --config=jest.config.cjs --coverage",
    "test:e2e:critical": "playwright test",
    "test:visual": "playwright test --project=chromium",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:prune": "node scripts/clean-visual-snapshots.cjs",
    "test:visual:headed": "playwright test --headed",
    "test:visual:debug": "playwright test --debug",
    "test:visual:report": "./scripts/download-playwright-report.sh",
    "deps:validate": "depcruise src --config --ignore-known .dependency-cruiser-known-violations.json",
    "deps:validate:strict": "depcruise src --config",
    "deps:baseline": "depcruise src --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "deps:diagram": "depcruise src --include-only '^src' --output-type mermaid --collapse '^src/[^/]+' > public_docs/architecture/dependency-graph-domains.mmd",
    "deps:diagram:archi": "command -v dot >/dev/null 2>&1 && depcruise src --config --output-type archi | dot -T svg -Grankdir=TD > public_docs/architecture/high-level.svg || echo 'Skipping archi diagram (requires: brew install graphviz)'",
    "deps:diagram:detailed": "depcruise src --include-only '^src' --output-type mermaid > public_docs/architecture/dependency-graph-detailed.mmd",
    "deps:diagram:stores": "depcruise src/state --include-only '^src/state' --output-type mermaid > public_docs/architecture/stores-dependencies.mmd",
    "deps:diagram:components": "depcruise src/components --include-only '^src/components' --output-type mermaid --collapse '^src/components/[^/]+' > public_docs/architecture/component-dependencies.mmd",
    "deps:diagram:folders": "depcruise src --include-only '^src' --output-type ddot | dot -T svg > public_docs/architecture/dependency-graph-folders.svg",
    "deps:diagram:svg": "depcruise src --include-only '^src' --output-type dot | dot -T svg > public_docs/architecture/dependency-graph.svg",
    "deps:diagram:interactive": "depcruise src --include-only '^src' --output-type dot | dot -T svg | depcruise-wrap-stream-in-html > public_docs/architecture/dependency-graph-interactive.html",
    "deps:diagram:all": "npm run deps:diagram && npm run deps:diagram:archi && npm run deps:diagram:detailed && npm run deps:diagram:stores && npm run deps:diagram:components && npm run deps:diagram:folders",
    "deps:html": "depcruise src --output-type err-html > public_docs/architecture/dependency-violations.html",
    "analyze": "npm run deps:validate && npm run deps:diagram:all",
    "docs:design-system:build": "node scripts/build-design-system-docs.mjs",
    "docs:design-system:check": "npm run docs:design-system:build && git diff --exit-code -- public_docs/design-system/redesign-planning/design-system.html public/design-system/index.html",
    "claude:pr-review": "bash scripts/claude-automation/pr-review.sh",
    "claude:fix-lint": "bash scripts/claude-automation/auto-fix-lint.sh",
    "claude:pre-commit": "bash scripts/claude-automation/pre-commit-review.sh"
  },
  "dependencies": {
    "@google/genai": "^0.13.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^0.548.0",
    "next": "^15.5.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.0",
    "react-joyride": "^3.0.0-7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/addon-styling-webpack": "^1.0.1",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-addon-test": "^8.6.12",
    "@storybook/experimental-nextjs-vite": "^8.6.12",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.12",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-joyride": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/browser": "^3.1.2",
    "@vitest/coverage-v8": "^3.1.2",
    "autoprefixer": "^10.4.21",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.3.6",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-storybook": "^0.12.0",
    "fishery": "^2.3.1",
    "gh-pages": "^6.3.0",
    "glob": "^11.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "kill-port": "^2.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.5.3",
    "storybook": "^8.6.12",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "overrides": {
    "react-joyride": {
      "react": "$react",
      "react-dom": "$react-dom",
      "react-floater": {
        "react": "$react",
        "react-dom": "$react-dom"
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerseycheese/narraitor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jerseycheese/Narraitor/issues"
  },
  "homepage": "https://github.com/jerseycheese/Narraitor#readme"
}
